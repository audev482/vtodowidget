<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_row"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- Optional Priority Indicator Strip -->
    <ImageView
        android:id="@+id/img_row_priority_bar"
        android:layout_width="3dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_priority_high"
        android:visibility="gone" />

    <!-- Interactive Checkbox Hit Target (generous 44dp click target) -->
    <FrameLayout
        android:id="@+id/btn_row_checkbox"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_cd_toggle_task">

        <ImageView
            android:id="@+id/img_row_checkbox"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_check_unchecked" />
    </FrameLayout>

    <!-- Task Summary & Metadata -->
    <LinearLayout
        android:id="@+id/row_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/txt_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Due Date Chip -->
    <TextView
        android:id="@+id/txt_row_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_due_chip"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:textColor="@color/due_upcoming_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
